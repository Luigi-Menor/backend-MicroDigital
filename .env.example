# Base de datos (PostgreSQL) — ver docker-compose.yml para levantar una local
DATABASE_URL="postgresql://microdigital:microdigital@localhost:5432/microdigital?schema=public"

# Secreto para firmar JWT (usar un valor largo y aleatorio en producción)
JWT_SECRET="cambia-este-valor-por-uno-seguro-y-aleatorio"

# Duración del token de sesión (en segundos). 8h por defecto.
JWT_EXPIRES_IN_SECONDS=28800

# Duración del enlace de recuperación de contraseña (RF-003): 15 minutos
PASSWORD_RESET_EXPIRES_MINUTES=15

# Google Sign-In (Google Identity Services). Crear un "OAuth 2.0 Client ID"
# de tipo "Web application" en https://console.cloud.google.com/apis/credentials
# y agregar el dominio de la app (ej. http://localhost:3000) en
# "Authorized JavaScript origins". No se necesita Client Secret: solo se
# verifica el ID token que entrega el botón de Google, no se hace
# intercambio de código de autorización.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="TU_CLIENT_ID.apps.googleusercontent.com"

# URL exacta del frontend (sin barra final). Requerida para CORS: el backend
# solo acepta peticiones con credenciales desde este origen. Ver
# src/lib/cors.ts y src/middleware.ts.
FRONTEND_URL="http://localhost:3000"

# Opcional. Dominio compartido para la cookie de sesión cuando frontend y
# backend viven en subdominios del mismo dominio en producción
# (ej. app.tudominio.com y api.tudominio.com). Dejar vacío en desarrollo
# local: en "localhost" los navegadores comparten cookies entre puertos
# aunque frontend y backend corran en puertos distintos, así que no hace
# falta configurarlo para desarrollar. Formato: ".tudominio.com"
COOKIE_DOMAIN=
